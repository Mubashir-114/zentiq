# ==============================================================================
# ZENTIQ — Environment Configuration Template
# Copy this file to .env and replace placeholder values with your environment configuration.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# In local development:
# - If no DB_PASSWORD is provided, Django defaults to local SQLite (backend/db.sqlite3).
# - To connect to MySQL locally, set DB_ENGINE=django.db.backends.mysql and provide valid credentials below.
# - To explicitly force SQLite, set DB_ENGINE=django.db.backends.sqlite3 or USE_SQLITE_TEST_DB=True.
# In production: MySQL 8.4 is mandatory; SQLite is strictly forbidden.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=zentiq_dev
DB_USER=zentiq_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Explicit Dev SQLite Toggle (Overrides DB_ENGINE to sqlite3 when set to True)
USE_SQLITE_TEST_DB=True

# Cross-Origin Resource Sharing (CORS) & Security
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Environment Variables (Vite requires VITE_ prefix for client-exposed vars)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

